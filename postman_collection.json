{
  "info": {
    "name": "vision_api",
    "description": "Vision API — CodeProject.AI-compatible HTTP surface. Endpoints: /v1/vision/ocr (Kreuzberg/Paddle), /v1/vision/detection (YOLO26), /v1/vision/face* (InsightFace detect/recognize/register/list/delete/match), /v1/vision/alpr (fast-alpr), /v1/vision/scene (Places365). All /v1/vision/* endpoints accept multipart/form-data and return the standard CodeProject.AI envelope ({success, message, predictions, count, inferenceMs, processMs, moduleId, ...}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8014",
      "type": "string"
    },
    {
      "key": "base64Image",
      "value": "",
      "type": "string",
      "description": "Base64-encoded image bytes (PNG/JPEG). May include a data URI prefix like 'data:image/png;base64,...'."
    }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe. Returns {\"status\": \"ok\"}."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/ocr",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image_file", "type": "file", "src": [], "description": "File upload. Used when image_bytes is empty. Images, PDFs, or (Kreuzberg only) office docs / HTML / email / archives." },
            { "key": "image_bytes", "type": "text", "value": "{{base64Image}}", "description": "Base64-encoded image bytes (optionally with a data URI prefix). Checked first; if non-empty, image_file is ignored.", "disabled": true },
            { "key": "min_confidence", "type": "text", "value": "0.4" },
            { "key": "engine", "type": "text", "value": "Kreuzberg", "description": "One of: Kreuzberg (Tesseract backend, default), Paddle (PaddleOCR, GPU recommended), Auto (Paddle for scanned PDFs, Kreuzberg otherwise)." },
            { "key": "improve_accuracy", "type": "text", "value": "false", "description": "Paddle-only HQ mode (PaddleOCRVL pipeline). Ignored by Kreuzberg." }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/ocr", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "ocr"] },
        "description": "Run OCR on an uploaded file or base64-encoded image bytes. Also available at /ocr for legacy clients."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/detection — YOLO26",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image", "type": "file", "src": [], "description": "Image to analyse." },
            { "key": "min_confidence", "type": "text", "value": "0.4", "description": "Drop predictions below this score." },
            { "key": "model", "type": "text", "value": "yolo26s", "description": "Optional. One of yolo26n / yolo26s / yolo26m / yolo26l / yolo26x. Default yolo26s." }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/detection", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "detection"] },
        "description": "Object detection (YOLO26). Returns CodeProject.AI envelope with predictions (x_min/y_min/x_max/y_max/label/confidence)."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face — face detection",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image", "type": "file", "src": [] },
            { "key": "min_confidence", "type": "text", "value": "0.4" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/face", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face"] },
        "description": "Detect all faces in an image (InsightFace SCRFD)."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face/recognize",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image", "type": "file", "src": [] },
            { "key": "min_confidence", "type": "text", "value": "0.5", "description": "Cosine-similarity threshold for an embedding match (0.0-1.0)." }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/face/recognize", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face", "recognize"] },
        "description": "Detect faces, then match each against the registry. Unmatched faces get userid='unknown'."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face/register",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "userid", "type": "text", "value": "alice" },
            { "key": "image1", "type": "file", "src": [] },
            { "key": "image2", "type": "file", "src": [], "description": "Optional additional reference image. Add image3, image4, ... as needed." }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/face/register", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face", "register"] },
        "description": "Enrol a userid by submitting one or more reference images. Highest-confidence face per image is stored."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face/list",
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "formdata", "formdata": [] },
        "url": { "raw": "{{baseUrl}}/v1/vision/face/list", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face", "list"] },
        "description": "List all registered userids."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face/delete",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "userid", "type": "text", "value": "alice" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/face/delete", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face", "delete"] },
        "description": "Delete a userid and all of its enrolled face embeddings."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/face/match",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image1", "type": "file", "src": [] },
            { "key": "image2", "type": "file", "src": [] }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/face/match", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "face", "match"] },
        "description": "Compare the most prominent face in image1 vs image2. Response includes `similarity` (cosine, 0.0-1.0)."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/alpr — license plate reader",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "upload", "type": "file", "src": [] },
            { "key": "min_confidence", "type": "text", "value": "0.4" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/alpr", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "alpr"] },
        "description": "Detect + OCR license plates with fast-alpr (YOLOv9 detector + fast-plate-ocr). Also available at /v1/image/alpr for legacy CodeProject.AI clients."
      },
      "response": []
    },
    {
      "name": "POST /v1/vision/scene — Places365",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image", "type": "file", "src": [] }
          ]
        },
        "url": { "raw": "{{baseUrl}}/v1/vision/scene", "host": ["{{baseUrl}}"], "path": ["v1", "vision", "scene"] },
        "description": "Top-1 scene classification over 365 Places categories (ResNet50). Response: label + confidence + top_k array."
      },
      "response": []
    }
  ]
}
